# LAKE_PASS_* is canonical. Legacy BUNTZEN_* settings remain accepted when the
# corresponding canonical name is unset; see docs/rebrand-migration.md.
LAKE_PASS_WEB_PORT=8080
BLUEBUBBLES_URL=http://bluebubbles.example:1234
# Required if using BlueBubbles: approve its origin/address in docs/public-exposure.md.
# This example applies only to a server reached over loopback from Lake Pass Bot:
# LAKE_PASS_BLUEBUBBLES_ENDPOINTS='[{"origin":"http://127.0.0.1:1234","networks":["127.0.0.1/32"]}]'
LAKE_PASS_YODEL_ORIGINS=https://yodelportal.com
LAKE_PASS_ALLOWED_HOSTS=docker-host.example:8080,lake-pass.example
# Optional fixed first-run token; when empty, a random token is printed once at startup:
# Optional: use 32 random bytes in unpadded URL-safe base64 (43 characters).
# Leave unset to generate a one-time token on first startup.
# LAKE_PASS_SETUP_TOKEN=
# If a reverse proxy rewrites Host, also add that rewritten authority above:
# LAKE_PASS_ALLOWED_ORIGINS=http://lake-pass.example
# Public HTTPS through a trusted cloudflared connector (see docs/public-exposure.md):
# LAKE_PASS_PUBLIC_ORIGIN=https://lake-pass.example
# LAKE_PASS_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Development diagnostics. LAKE_PASS_DEBUG=true is a convenience override that
# sets both the Go control plane and isolated Python workers to debug logging.
LAKE_PASS_LOG_LEVEL=info
LAKE_PASS_DEBUG=false
# Optional operator-only custom browser installation (absolute executable path):
# LAKE_PASS_BROWSER_EXECUTABLE=/opt/google/chrome/chrome
MAX_CONCURRENT_JOBS=2
# Keep these container limits finite when sizing additional workers:
LAKE_PASS_CPU_LIMIT=2.0
LAKE_PASS_MEMORY_LIMIT=4g
LAKE_PASS_PIDS_LIMIT=512
SCHEDULES_ENABLED=false
# Optional existing key outside appdata; see docs/public-exposure.md before moving it:
# LAKE_PASS_KEY_DIRECTORY_PATH=/srv/lake-pass-key
# LAKE_PASS_MASTER_KEY_FILE=/run/buntzen-key/master.key
