WEB_PORT=8080
BLUEBUBBLES_URL=http://bluebubbles.example:1234
# Required if using BlueBubbles: approve its origin/address in docs/public-exposure.md.
# This example applies only to a server reached over loopback from Buntzen:
# BUNTZEN_BLUEBUBBLES_ENDPOINTS='[{"origin":"http://127.0.0.1:1234","networks":["127.0.0.1/32"]}]'
BUNTZEN_YODEL_ORIGINS=https://yodelportal.com
BUNTZEN_ALLOWED_HOSTS=docker-host.example:8080,buntzen.example
# Optional fixed first-run token; when empty, a random token is printed once at startup:
# Optional: use 32 random bytes in unpadded URL-safe base64 (43 characters).
# Leave unset to generate a one-time token on first startup.
# BUNTZEN_SETUP_TOKEN=
# If a reverse proxy rewrites Host, also add that rewritten authority above:
# BUNTZEN_ALLOWED_ORIGINS=http://buntzen.example
# Public HTTPS through a trusted cloudflared connector (see docs/public-exposure.md):
# BUNTZEN_PUBLIC_ORIGIN=https://buntzen.example
# BUNTZEN_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Development diagnostics. BUNTZEN_DEBUG=true is a convenience override that
# sets both the Go control plane and isolated Python workers to debug logging.
BUNTZEN_LOG_LEVEL=info
BUNTZEN_DEBUG=false
# Optional operator-only custom browser installation (absolute executable path):
# BUNTZEN_BROWSER_EXECUTABLE=/opt/google/chrome/chrome
MAX_CONCURRENT_JOBS=2
# Keep these container limits finite when sizing additional workers:
BUNTZEN_CPU_LIMIT=2.0
BUNTZEN_MEMORY_LIMIT=4g
BUNTZEN_PIDS_LIMIT=512
SCHEDULES_ENABLED=false
# Optional existing key outside appdata; see docs/public-exposure.md before moving it:
# BUNTZEN_KEY_DIRECTORY_PATH=/srv/buntzen-key
# BUNTZEN_MASTER_KEY_FILE=/run/buntzen-key/master.key
