# Used only to bootstrap the built-in administrator on an empty appdata volume.
# After first launch, the Argon2id hash in SQLite is authoritative.
BUNTZEN_ADMIN_PASSWORD=replace-with-at-least-12-characters
BUNTZEN_ADMIN_USERNAME=admin

WEB_PORT=8080
BLUEBUBBLES_URL=http://bluebubbles.example:1234
# Optional if a local reverse proxy rewrites Host instead of preserving it:
# BUNTZEN_ALLOWED_ORIGINS=http://buntzen.example
MAX_CONCURRENT_JOBS=2
SCHEDULES_ENABLED=false
